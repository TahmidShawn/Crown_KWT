# Local dev — copy to .env and fill in real values (never commit .env)
VITE_API_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Store contact details (used by the footer + WhatsApp float)
# Digits only, with country code, e.g. 96512345678
VITE_WHATSAPP_NUMBER=96522222222
VITE_CONTACT_EMAIL=hello@crownkwt.com
